# Telegram Bot Token from BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Run mode: "polling" or "webhook" (default is polling)
RUN_MODE=polling

# Timezone (e.g. Europe/Moscow, UTC, America/New_York). 
# If not set, defaults to the local system timezone.
# TIMEZONE=Europe/Moscow

# --- Webhook Settings (Required only if RUN_MODE=webhook) ---
# The public URL of your server (e.g. https://your-app.onrender.com)
# Webhook host must use HTTPS
WEBHOOK_HOST=https://your-app.onrender.com
WEBHOOK_PATH=/webhook

# Port to listen on (Render/Railway will automatically provide PORT)
PORT=8080
HOST=0.0.0.0
